{
  "packageFormatVersion": 1,
  "id": "xfestudio.space-engineers-plugin-manager",
  "name": "太空工程师插件管理器",
  "subtitle": "XFE 自研加载器 · 插件管理与自动重启",
  "version": "1.0.0",
  "description": "为 Space Engineers 构建独立的 XFE 插件加载器，管理本地插件及依赖、启用清单和启动参数，支持正常启动、退出、重启、源文件变化后同步以及配置备份恢复。",
  "author": "XFEstudio",
  "icon": "Assets/icon.png",
  "category": "游戏工具",
  "tags": ["Space Engineers", "太空工程师", "插件", "XFE Loader", "开发"],
  "minimumHostVersion": "1.2.1",
  "releaseNotes": "首个版本：自研 XFE 加载器、本地插件与依赖管理、游戏启停、源文件监视、自动重启与配置备份。",
  "nugetPackages": [],
  "requiresAdministrator": false,
  "entry": {
    "viewXaml": "Code/Views/MainPage.xaml",
    "viewClass": "XFEToolBox.Tools.SpaceEngineers.Views.MainPage",
    "viewCodeBehind": "Code/Views/MainPage.xaml.cs",
    "viewModel": "Code/ViewModels/MainPageViewModel.cs",
    "viewModelClass": "XFEToolBox.Tools.SpaceEngineers.ViewModels.MainPageViewModel"
  },
  "window": {
    "width": 1080,
    "height": 760,
    "minWidth": 820,
    "minHeight": 580,
    "allowResize": true,
    "allowMaximize": true,
    "showMinimizeButton": true,
    "showCloseButton": true
  },
  "requestedPermissions": ["FileSystem", "Process", "Registry", "Shell"]
}
