<Page x:Class="XFEToolBox.Client.Installer.Views.Pages.Popups.NormalDialogPopupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:viewmodel="clr-namespace:XFEToolBox.Client.Installer.ViewModel.Pages.Popups"
      xmlns:controls="clr-namespace:XFEToolBox.WpfCore.Controls;assembly=XFEToolBox.WpfCore"
      mc:Ignorable="d" d:DesignHeight="190" d:DesignWidth="330"
      d:DataContext="{d:DesignInstance Type=viewmodel:NormalDialogPopupPageViewModel}"
      Background="Transparent" Title="提示">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Frame Content="{Binding Content}" NavigationUIVisibility="Hidden" Background="Transparent"/>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ConfirmGridLength}"/>
                <ColumnDefinition Width="{Binding YesGridLength}"/>
                <ColumnDefinition Width="{Binding NoGridLength}"/>
                <ColumnDefinition Width="{Binding CancelGridLength}"/>
            </Grid.ColumnDefinitions>
            <Button Margin="4,0" Height="38" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                    controls:ButtonAssist.IsPrimary="True"/>
            <Button Grid.Column="1" Margin="4,0" Height="38" Content="{Binding YesText}" Command="{Binding YesCommand}"
                    controls:ButtonAssist.IsPrimary="True"/>
            <Button Grid.Column="2" Margin="4,0" Height="38" Content="{Binding NoText}" Command="{Binding NoCommand}"/>
            <Button Grid.Column="3" Margin="4,0" Height="38" Content="{Binding CancelText}" Command="{Binding CancelCommand}"/>
        </Grid>
    </Grid>
</Page>
