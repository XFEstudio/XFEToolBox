<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icon\Icon.ico</ApplicationIcon>
    <AssemblyName>Installer</AssemblyName>
    <Version>1.1.3</Version>
    <EmbedInstallationPackage Condition="'$(EmbedInstallationPackage)' == ''">true</EmbedInstallationPackage>
    <InstallationPackagePath Condition="'$(InstallationPackagePath)' == ''">Resources\Resource\Source.zip</InstallationPackagePath>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Image\back.png" />
    <None Remove="Resources\Image\background.png" />
    <None Remove="Resources\Image\clean.png" />
    <None Remove="Resources\Image\console.png" />
    <None Remove="Resources\Image\download.png" />
    <None Remove="Resources\Image\grid.png" />
    <None Remove="Resources\Image\restart.png" />
    <None Remove="Resources\Image\setting.png" />
    <None Remove="Resources\Image\start.png" />
    <None Remove="Resources\Image\stop.png" />
    <None Remove="Resources\Image\toolbox.png" />
    <None Remove="Resources\Image\wrench.png" />
    <None Remove="Resources\Resource\EULA.txt" />
    <None Remove="Resources\Resource\PrivateService.txt" />
    <None Remove="Resources\Resource\Source.zip" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Resource\EULA.txt" />
    <EmbeddedResource Include="Resources\Resource\PrivateService.txt" />
    <EmbeddedResource Include="$(InstallationPackagePath)"
                      LogicalName="XFEToolBox.Client.Installer.Resources.Resource.Source.zip"
                      Condition="'$(EmbedInstallationPackage)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="XFEExtension.NetCore" Version="5.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XFEToolBox.WpfCore\XFEToolBox.WpfCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icon\Icon.ico" />
    <Resource Include="Resources\Icon\Icon.png" />
    <Resource Include="Resources\Image\back.png" />
    <Resource Include="Resources\Image\background.png" />
    <Resource Include="Resources\Image\clean.png" />
    <Resource Include="Resources\Image\console.png" />
    <Resource Include="Resources\Image\download.png" />
    <Resource Include="Resources\Image\grid.png" />
    <Resource Include="Resources\Image\restart.png" />
    <Resource Include="Resources\Image\setting.png" />
    <Resource Include="Resources\Image\start.png" />
    <Resource Include="Resources\Image\stop.png" />
    <Resource Include="Resources\Image\toolbox.png" />
    <Resource Include="Resources\Image\wrench.png" />
  </ItemGroup>

</Project>
