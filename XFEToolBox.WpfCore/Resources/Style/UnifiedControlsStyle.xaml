        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolTextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
