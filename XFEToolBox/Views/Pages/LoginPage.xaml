<Page x:Class="XFEToolBox.Client.Views.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F7F8FC" Title="登录">
    <Page.Resources>
        <Style x:Key="RoundInput" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E2E5F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFD"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7777DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#6666CE"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F8FC" Offset="0"/>
                <GradientStop Color="#EEEFFF" Offset="0.52"/>
                <GradientStop Color="#F9F4FF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="330" Height="330" Fill="#229898E7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-120,0"/>
        <Ellipse Width="230" Height="230" Fill="#18C79AF0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-115,0,0,-120"/>
        <Border Width="410" Padding="34,30" Background="#F8FFFFFF" CornerRadius="22" BorderBrush="#99FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#423C76" BlurRadius="28" ShadowDepth="8" Opacity="0.17"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="54" Height="54" CornerRadius="17" Background="#9898E7" HorizontalAlignment="Left">
                    <TextBlock Text="X" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="欢迎回来" FontSize="27" FontWeight="Bold" Foreground="#26263B" Margin="0,18,0,4"/>
                <TextBlock Text="登录后同步工具；管理员可进入服务器控制台。" FontSize="13" Foreground="#77778C" Margin="0,0,0,22"/>
                <TextBlock Text="账号" Foreground="#55556B" FontWeight="SemiBold" Margin="2,0,0,7"/>
                <TextBox x:Name="AccountTextBox" Style="{StaticResource RoundInput}"/>
                <TextBlock Text="密码" Foreground="#55556B" FontWeight="SemiBold" Margin="2,16,0,7"/>
                <Border Height="44" Background="#FAFAFD" BorderBrush="#E2E5F2" BorderThickness="1" CornerRadius="3">
                    <PasswordBox x:Name="PasswordInput" Padding="14,0" FontSize="14" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" KeyDown="PasswordInput_KeyDown"/>
                </Border>
                <Expander Header="服务器设置" Foreground="#77778C" FontSize="12" Margin="0,13,0,0">
                    <TextBox x:Name="ServerAddressTextBox" Style="{StaticResource RoundInput}" Height="36" FontSize="12" Margin="0,8,0,0"/>
                </Expander>
                <TextBlock x:Name="StatusText" Text=" " Foreground="#D45454" TextWrapping="Wrap" MinHeight="34" Margin="2,10,0,0"/>
                <Button x:Name="LoginButton" Content="登录工具箱" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click"/>
                <TextBlock Text="初始管理员：admin / ChangeMe_123!" Foreground="#9999AA" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
