<Page x:Class="XFEToolBox.Client.Views.Pages.Admin.ServerOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Title="" Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="BorderBrush" Value="#ECECF5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#7777DB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,8"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,10,14,12">
            <Grid Height="38" Margin="7,0,7,8">
                <Button Content="刷新" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click"/>
            </Grid>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="运行状态" Foreground="#85859B"/><TextBlock x:Name="StatusValue" Text="正在读取…" FontSize="23" FontWeight="Bold" Foreground="#45A36F" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="用户 / 活跃会话" Foreground="#85859B"/><TextBlock x:Name="UsersValue" Text="--" FontSize="23" FontWeight="Bold" Foreground="#5555B8" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="工具包 / 已发布" Foreground="#85859B"/><TextBlock x:Name="PackagesValue" Text="--" FontSize="23" FontWeight="Bold" Foreground="#5555B8" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="存储占用" Foreground="#85859B"/><TextBlock x:Name="StorageValue" Text="--" FontSize="23" FontWeight="Bold" Foreground="#5555B8" Margin="0,8,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource MetricCard}" Margin="7,16,7,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#EEEEFF"><TextBlock Text="☁" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6666CC"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ServerNameValue" Text="XFEToolBoxServer" FontSize="16" FontWeight="SemiBold" Foreground="#333348"/>
                        <TextBlock x:Name="UpdatedValue" Text="尚未连接" Foreground="#8A8A9D" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="#D45454" Margin="10,10" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
