<Page x:Class="XFEToolBox.Client.Views.Pages.Admin.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:XFEToolBox.Client.Views.Controls"
      Background="Transparent" Title="" Loaded="Page_Loaded">
    <Grid Margin="14,9,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource AdminPageHeaderIcon}">
                <Grid Width="23" Height="23">
                    <Ellipse Width="8" Height="8" Margin="0,0,9,9" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="White" StrokeThickness="1.7"/>
                    <Path Width="13" Height="7" Margin="0,10,9,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 1,6 C 1,3 3.2,1 6.5,1 C 9.8,1 12,3 12,6" Stretch="Fill"
                          Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Width="6" Height="6" Margin="12,1,0,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="#DFFFFFFF" StrokeThickness="1.5"/>
                    <Path Width="9" Height="5" Margin="13,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 1,4 C 1,2 2.5,1 4.5,1 C 6.5,1 8,2 8,4" Stretch="Fill"
                          Stroke="#DFFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="用户与权限" Style="{StaticResource AdminPageTitle}"/>
                <TextBlock Text="管理服务器账号、角色与访问状态" Style="{StaticResource AdminPageSubtitle}"/>
            </StackPanel>
            <Button Grid.Column="2" Content="刷新列表"
                    VerticalAlignment="Center" Click="RefreshButton_Click"/>
        </Grid>

        <Border Grid.Row="1" MinHeight="155" Style="{StaticResource AdminCard}" Margin="0,10,0,10" Padding="17,14,17,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,11">
                    <StackPanel>
                        <TextBlock Text="用户列表" Style="{StaticResource AdminSectionTitle}"/>
                        <TextBlock Text="选择用户后，可在下方修改密码、角色或启用状态" Style="{StaticResource AdminSectionSubtitle}"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"
                            Background="#EEEEF8" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#72CE9A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" MaxWidth="180" Foreground="#508264" FontSize="9.5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <controls:RoundedClipBorder Grid.Row="1" MinHeight="80" Background="White" BorderBrush="#E5E5F0" BorderThickness="1" CornerRadius="12">
                    <DataGrid x:Name="UserGrid" Style="{StaticResource AdminDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding UserName}" Width="*"/>
                            <DataGridTextColumn Header="昵称" Binding="{Binding NickName}" Width="*"/>
                            <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="105"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:RoundedClipBorder>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AdminCard}" Padding="17,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="新建用户" Style="{StaticResource AdminSectionTitle}"/>
                        <TextBlock Text="创建普通账号，也可以直接授予管理员权限" Style="{StaticResource AdminSectionSubtitle}"/>
                    </StackPanel>
                    <CheckBox x:Name="NewIsAdmin" Content="创建为管理员" Style="{StaticResource AdminCheckBox}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:TextEditor x:Name="NewUserName" Style="{StaticResource AdminTextEditor}"
                                         Margin="0,0,8,0" HintText="账号" ToolTip="账号"/>
                    <controls:TextEditor x:Name="NewNickName" Grid.Column="1" Style="{StaticResource AdminTextEditor}"
                                         Margin="0,0,8,0" HintText="昵称" ToolTip="昵称"/>
                    <controls:PasswordEditor x:Name="NewPassword" Grid.Column="2" Style="{StaticResource AdminPasswordEditor}"
                                                  Margin="0,0,8,0" HintText="密码（至少 8 位）" ToolTip="密码（至少 8 位）"/>
                    <Button Grid.Column="3" Content="创建用户" controls:ButtonAssist.IsPrimary="True"
                            MinWidth="88" Click="CreateButton_Click"/>
                </Grid>

                <Border Grid.Row="2" Height="1" Background="#E6E6F0" Margin="0,10"/>

                <Grid Grid.Row="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <controls:PasswordEditor x:Name="ResetPassword" Width="155"
                                                      Style="{StaticResource AdminPasswordEditor}" Margin="0,0,8,0"
                                                      HintText="设置新密码" ToolTip="为选中用户设置新密码"/>
                        <Button Content="重置密码" Margin="0,0,7,0"
                                Click="ResetPasswordButton_Click"/>
                        <Button Content="切换角色" Margin="0,0,7,0"
                                Click="ToggleRoleButton_Click"/>
                        <Button Content="启用 / 禁用" MinWidth="88"
                                Click="ToggleStatusButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
