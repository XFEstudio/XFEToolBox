<Page x:Class="XFEToolBox.Client.Views.Pages.Admin.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Title="" Loaded="Page_Loaded">
    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Height="38">
            <Button Content="刷新" HorizontalAlignment="Right" Padding="17,0" Background="#6666C5" Foreground="White" BorderBrush="#E0E0FF" Click="RefreshButton_Click"/>
        </Grid>
        <Border Grid.Row="1" Background="White" CornerRadius="15" BorderBrush="#E9E9F3" BorderThickness="1" Margin="0,10,0,10" Padding="8">
            <DataGrid x:Name="UserGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="账号" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="昵称" Binding="{Binding NickName}" Width="*"/>
                    <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="100"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="2" Background="#26FFFFFF" CornerRadius="15" BorderBrush="#60FFFFFF" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="新建用户" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NewUserName" Margin="0,0,8,0" Padding="10,8" BorderBrush="#DEDEEA" ToolTip="账号"/>
                    <TextBox x:Name="NewNickName" Grid.Column="1" Margin="0,0,8,0" Padding="10,8" BorderBrush="#DEDEEA" ToolTip="昵称"/>
                    <PasswordBox x:Name="NewPassword" Grid.Column="2" Margin="0,0,8,0" Padding="10,8" BorderBrush="#DEDEEA" ToolTip="密码（至少 8 位）"/>
                    <Button Grid.Column="3" Content="创建" Padding="18,8" Background="#7777DB" Foreground="White" BorderThickness="0" Click="CreateButton_Click"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <CheckBox x:Name="NewIsAdmin" Content="创建为管理员" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <PasswordBox x:Name="ResetPassword" Width="145" Padding="8,6" Margin="0,0,8,0" ToolTip="为选中用户设置新密码"/>
                        <Button Content="重置密码" Padding="12,7" Margin="0,0,8,0" Click="ResetPasswordButton_Click"/>
                        <Button Content="切换角色" Padding="12,7" Margin="0,0,8,0" Click="ToggleRoleButton_Click"/>
                        <Button Content="启用 / 禁用" Padding="12,7" Click="ToggleStatusButton_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="StatusText" Foreground="White" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
