<Page x:Class="XFEToolBox.Client.Views.Pages.Admin.SoftwareManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:XFEToolBox.Client.Views.Controls"
      Background="Transparent" Title="" Loaded="Page_Loaded">
    <Grid Margin="14,9,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource AdminPageHeaderIcon}">
                <Grid Width="23" Height="23">
                    <Path Width="19" Height="19" Stretch="Uniform" Stroke="White" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 2,5 L 11,1 L 20,5 L 11,9 Z M 2,5 L 2,14 L 11,19 L 20,14 L 20,5 M 11,9 L 11,19"/>
                    <Path Width="7" Height="7" Margin="10,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stretch="Uniform" Stroke="#DFFFFFFF" StrokeThickness="1.4"
                          Data="M 1,1 L 6,1 L 6,6"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="软件发布" Style="{StaticResource AdminPageTitle}"/>
                <TextBlock Text="维护下载专区的软件信息、渠道与展示状态" Style="{StaticResource AdminPageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="新建软件" controls:ButtonAssist.IsPrimary="True" Margin="0,0,8,0"
                        Click="NewButton_Click"/>
                <Button Content="刷新目录"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <controls:RoundedClipBorder Grid.Row="1" Style="{StaticResource AdminCard}" Margin="0,10,0,9" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="15,14,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="2,0,0,11">
                        <TextBlock Text="软件目录" Style="{StaticResource AdminSectionTitle}"/>
                        <TextBlock Text="选择条目进行编辑" Style="{StaticResource AdminSectionSubtitle}"/>
                    </StackPanel>
                    <ListBox x:Name="SoftwareList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource AdminListBoxItem}"
                             SelectionChanged="SoftwareList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" CornerRadius="2" Background="{DynamicResource MainColor}" Opacity="0.75"/>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Name}" Foreground="#46465B" FontSize="11"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Version}" Foreground="#9696A8" FontSize="9"/>
                                            <TextBlock Text="{Binding Id}" Foreground="#A1A1B2" FontSize="8.5"
                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="72"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="1" Background="#E8E8F1" Margin="0,14"/>

                <Grid Grid.Column="2" Margin="17,14,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,5,0">
                        <StackPanel>
                        <Grid Margin="1,0,0,13">
                            <StackPanel>
                                <TextBlock Text="软件信息" Style="{StaticResource AdminSectionTitle}"/>
                                <TextBlock Text="基础资料会展示在下载专区的软件详情中" Style="{StaticResource AdminSectionSubtitle}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5"
                                    Background="#EEEEF8" CornerRadius="10">
                                <TextBlock Text="编辑模式" Foreground="#77778C" FontSize="9.5"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="软件标识" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="IdTextBox" Style="{StaticResource AdminTextEditor}" HintText="例如 xfe.studio.app"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="软件名称" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="NameTextBox" Style="{StaticResource AdminTextEditor}" HintText="对用户显示的名称"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="一句话介绍" Style="{StaticResource AdminFormLabel}" Margin="2,10,0,5"/>
                        <controls:TextEditor x:Name="SummaryTextBox" Style="{StaticResource AdminTextEditor}" HintText="简要说明软件用途"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="发布者" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="PublisherTextBox" Style="{StaticResource AdminTextEditor}" HintText="发布者"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="分类" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="CategoryTextBox" Style="{StaticResource AdminTextEditor}" HintText="效率工具"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="版本" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="VersionTextBox" Style="{StaticResource AdminTextEditor}" HintText="最新版"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="官网地址" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="WebsiteTextBox" Style="{StaticResource AdminTextEditor}" HintText="https://"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="图标地址（可留空）" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="IconTextBox" Style="{StaticResource AdminTextEditor}" HintText="https://"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="详细介绍" Style="{StaticResource AdminFormLabel}" Margin="2,10,0,5"/>
                        <controls:TextEditor x:Name="DescriptionTextBox" Height="66" Style="{StaticResource AdminTextEditor}"
                                             Padding="11,8" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" HintText="介绍主要功能和使用场景"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="注意事项" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="NoticeTextBox" Style="{StaticResource AdminTextEditor}" HintText="可选"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="标签（逗号分隔）" Style="{StaticResource AdminFormLabel}"/>
                                <controls:TextEditor x:Name="TagsTextBox" Style="{StaticResource AdminTextEditor}" HintText="开发, 效率"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#E6E6F0" Margin="0,16,0,14"/>

                        <StackPanel Margin="1,0,0,10">
                            <StackPanel>
                                <TextBlock Text="下载渠道" Style="{StaticResource AdminSectionTitle}"/>
                                <TextBlock Text="为同一软件配置官网、镜像或服务器文件" Style="{StaticResource AdminSectionSubtitle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Button Content="添加渠道" MinWidth="68" Margin="0,0,7,0"
                                        Click="AddChannelButton_Click"/>
                                <Button Content="移除渠道" MinWidth="68" Margin="0,0,7,0"
                                        Click="RemoveChannelButton_Click"/>
                                <Button Content="上传到此渠道" MinWidth="100"
                                        Click="UploadChannelButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <controls:RoundedClipBorder Background="White" BorderBrush="#E2E2ED" BorderThickness="1" CornerRadius="11">
                            <DataGrid x:Name="ChannelGrid" Height="138" Style="{StaticResource AdminDataGrid}" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="标识" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="88"/>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridComboBoxColumn x:Name="ModeColumn" Header="方式"
                                                            SelectedItemBinding="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Width="82"/>
                                    <DataGridTextColumn Header="地址 / 文件名" Binding="{Binding DisplayAddress, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                                    <DataGridTemplateColumn Header="启用" Width="64" HeaderStyle="{StaticResource AdminDataGridCenteredHeader}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource AdminGridCheckBox}" ToolTip="启用此下载渠道"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </controls:RoundedClipBorder>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Margin="0,10,5,0" Padding="1,10,1,0"
                            BorderBrush="#E6E6F0" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="EnabledCheckBox" Content="可用" IsChecked="True"
                                          Style="{StaticResource AdminCheckBox}" Margin="0,0,15,0"/>
                                <CheckBox x:Name="PublishedCheckBox" Content="已发布" IsChecked="False"
                                          Style="{StaticResource AdminCheckBox}" Margin="0,0,15,0"/>
                                <CheckBox x:Name="FeaturedCheckBox" Content="精选" Style="{StaticResource AdminCheckBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="删除" MinWidth="64" Margin="0,0,7,0"
                                        Click="DeleteButton_Click"/>
                                <Button x:Name="PublicationButton" Content="切换发布状态"
                                        MinWidth="104" Margin="0,0,7,0" Click="PublicationButton_Click"/>
                                <Button x:Name="SaveButton" Content="保存更改" controls:ButtonAssist.IsPrimary="True"
                                        MinWidth="88" Click="SaveButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </controls:RoundedClipBorder>

        <Border Grid.Row="2" Background="#26FFFFFF" BorderBrush="#50FFFFFF" BorderThickness="1"
                CornerRadius="12" Padding="11,7">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#A7F2C5" Margin="2,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Foreground="#ECFFFFFF" FontSize="10"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
