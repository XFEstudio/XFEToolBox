<Page x:Class="XFEToolBox.Client.Views.Pages.Admin.ToolManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:XFEToolBox.Client.Views.Controls"
      Background="Transparent" Title="" Loaded="Page_Loaded">
    <Grid Margin="14,9,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource AdminPageHeaderIcon}">
                <Grid Width="23" Height="23">
                    <Path Width="19" Height="19" Stretch="Uniform" Stroke="White" StrokeThickness="1.65"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 3,7 L 8,2 L 13,7 L 8,12 Z M 13,7 L 18,4 L 18,14 L 13,17 L 13,7 M 8,12 L 13,17 M 8,12 L 8,19 M 3,7 L 3,15 L 8,19"/>
                    <Ellipse Width="5" Height="5" Fill="#DFFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="工具发布" Style="{StaticResource AdminPageTitle}"/>
                <TextBlock Text="上传、校验并控制工具版本的公开状态" Style="{StaticResource AdminPageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="项目" Margin="0,0,8,0"
                        Click="OpenProjectsButton_Click"/>
                <Button Content="上传工具包" Margin="0,0,8,0"
                        Click="UploadButton_Click"/>
                <Button Content="刷新" MinWidth="66"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource AdminCard}" Margin="0,10,0,10" Padding="17,14,17,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,11">
                    <StackPanel>
                        <TextBlock Text="工具版本" Style="{StaticResource AdminSectionTitle}"/>
                        <TextBlock Text="选中版本后，可在页面底部切换发布或下架" Style="{StaticResource AdminSectionSubtitle}"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"
                            Background="#EEEEF8" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#8F8FE9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text=".xfetool 工具包" Foreground="#77778C" FontSize="9.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" Background="White" BorderBrush="#E5E5F0" BorderThickness="1"
                        CornerRadius="12" ClipToBounds="True">
                    <DataGrid x:Name="ToolGrid" Style="{StaticResource AdminDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="工具" Binding="{Binding Manifest.Name}" Width="1.15*"/>
                            <DataGridTextColumn Header="标识" Binding="{Binding Manifest.Id}" Width="*"/>
                            <DataGridTextColumn Header="版本" Binding="{Binding Manifest.Version}" Width="90"/>
                            <DataGridCheckBoxColumn Header="已发布" Binding="{Binding Package.Published}" Width="80"/>
                            <DataGridTextColumn Header="大小（字节）" Binding="{Binding Package.PackageSize}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#26FFFFFF" BorderBrush="#50FFFFFF" BorderThickness="1"
                CornerRadius="14" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Width="28" Height="28" CornerRadius="9" Background="#28FFFFFF" Margin="0,0,9,0">
                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 7,1 L 7,8 M 4,5 L 7,8 L 10,5 M 2,10 L 2,12 L 12,12 L 12,10"/>
                    </Border>
                    <TextBlock x:Name="StatusText" Foreground="#ECFFFFFF" FontSize="10.5"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="切换选中版本的发布状态" controls:ButtonAssist.IsPrimary="True"
                        HorizontalAlignment="Right" MinWidth="178" Click="TogglePublicationButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
