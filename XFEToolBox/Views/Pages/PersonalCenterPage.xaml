<Page x:Class="XFEToolBox.Client.Views.Pages.PersonalCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:XFEToolBox.Client.Views.Controls"
      Background="Transparent" Title="" Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3E3E54"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#77778C"/><Setter Property="FontSize" Value="10.5"/><Setter Property="Margin" Value="2,0,0,5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="14,10,14,12">
            <Border Background="White" BorderBrush="#E8E8F2" BorderThickness="1" CornerRadius="17" Padding="22">
                <Grid>
                    <StackPanel x:Name="LoggedOutPanel">
                        <Grid Margin="0,0,0,17">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="12" Background="#9292E5"><TextBlock Text="X" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="XFE 工具箱账户" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="登录为可选功能，本地工具仍可正常使用。" Foreground="#9494A6" FontSize="9.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Padding="22" Background="#F8F8FC" BorderBrush="#E7E7F0" BorderThickness="1" CornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="#EAEAFB" CornerRadius="16">
                                    <Path Width="24" Height="24" Stretch="Uniform" Stroke="#8585DF" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 12,3 C 15.3,3 18,5.7 18,9 C 18,12.3 15.3,15 12,15 C 8.7,15 6,12.3 6,9 C 6,5.7 8.7,3 12,3 Z M 3,23 C 3.8,18.7 7.2,16.5 12,16.5 C 16.8,16.5 20.2,18.7 21,23"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="登录后解锁账户功能" Foreground="#48485F" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="同步个人资料，并使用工具服务器提供的在线功能。" Foreground="#9292A5"
                                               FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenLoginButton" Content="登录" controls:ButtonAssist.IsPrimary="True" Height="37"
                                    Click="OpenLoginButton_Click"/>
                            <Button x:Name="OpenRegisterButton" Grid.Column="2" Content="注册新账号"
                                    Height="37" Click="OpenRegisterButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="LoggedOutStatusText" Margin="2,13,2,0" Foreground="#68687E"
                                   FontSize="10.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel x:Name="LoggedInPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="15" Background="#9292E5"><TextBlock Text="X" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileDisplayName" Foreground="#3A3A50" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="ProfileAccountRole" Foreground="#8D8DA0" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="退出登录" Click="LogoutButton_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="个人资料" Style="{StaticResource SectionTitle}" Margin="0,0,0,13"/>
                                <TextBlock Text="昵称" Style="{StaticResource FieldLabel}"/>
                                <controls:TextEditor x:Name="ProfileNickNameTextBox" Height="37" Padding="11,0" Background="#F8F8FC" EditorBorderBrush="#E1E1EC" HintText="昵称" HintTextMargin="0"/>
                                <TextBlock Text="个人简介" Style="{StaticResource FieldLabel}" Margin="2,11,0,5"/>
                                <controls:TextEditor x:Name="ProfileBioTextBox" Height="94" Padding="10,8"
                                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     MaxLength="300" MinLines="3" Background="#F8F8FC" Foreground="#55556A"
                                                     EditorBorderBrush="#E1E1EC" EditorHoverBorderBrush="#BDBDE0" EditorFocusedBorderBrush="#8585DF"
                                                     EditorCornerRadius="11" HintText="介绍一下自己（最多 300 字）" HintForeground="#9999AA"
                                                     HintTextMargin="0,1,0,0" HintTextVerticalAlignment="Top"/>
                                <Button x:Name="SaveProfileButton" Content="保存个人资料" controls:ButtonAssist.IsPrimary="True" Height="37" Margin="0,15,0,0" Click="SaveProfileButton_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="账户安全" Style="{StaticResource SectionTitle}" Margin="0,0,0,13"/>
                                <Border Padding="17" Background="#F8F8FC" BorderBrush="#E5E5EF" BorderThickness="1" CornerRadius="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="#EAEAFB" CornerRadius="12">
                                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="#8585DF" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M 5,9 L 5,6.5 C 5,2.5 11,2.5 11,6.5 L 11,9 M 3,9 L 13,9 L 13,16 L 3,16 Z M 8,12 L 8,14"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="登录密码" Foreground="#4D4D64" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="定期更新密码有助于保护账户安全" Foreground="#9696A8" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button x:Name="ChangePasswordButton" Content="修改密码" Height="37"
                                        Margin="0,14,0,0" Click="ChangePasswordButton_Click"/>
                                <TextBlock Text="点击后将在独立窗口中验证当前密码。" Foreground="#9A9AAB"
                                           FontSize="9" Margin="2,9,2,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LoggedInStatusText" Margin="2,16,2,0" Foreground="#68687E" FontSize="10.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
