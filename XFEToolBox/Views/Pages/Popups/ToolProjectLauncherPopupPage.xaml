<Page x:Class="XFEToolBox.Client.Views.Pages.Popups.ToolProjectLauncherPopupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White" Loaded="Page_Loaded">
    <Page.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Padding="13,10" Background="#F8F8FC" BorderBrush="#E7E6F1"
                                BorderThickness="1" CornerRadius="12" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F1F0FC"/><Setter TargetName="Surface" Property="BorderBrush" Value="#C8C7EE"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E9E8FA"/><Setter TargetName="Surface" Property="BorderBrush" Value="#AFAEE8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="20,17,20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="历史工具项目" Foreground="#3F3F55" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="选择项目后才会打开代码工坊，路径失效的项目可以从历史中移除。" Foreground="#858598" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Content="浏览其他项目" Style="{StaticResource AdminPrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    MinWidth="108" Click="BrowseProjectButton_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,15,0,12">
            <ListBox x:Name="ProjectList" Background="Transparent" BorderThickness="0" SelectionChanged="ProjectList_SelectionChanged"
                     MouseDoubleClick="ProjectList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="31" Height="31" CornerRadius="10" Background="#E8E7FA">
                                <TextBlock Text="&lt;/&gt;" Foreground="#7777C9" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="#46465C" FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ProjectPath}" Foreground="#77778C" FontSize="8.8" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectPath}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding StateText}" Foreground="#7777C9" FontSize="9" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding LastOpenedText}" Foreground="#9A9AAA" FontSize="8" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="15" Background="#F0EFFC" HorizontalAlignment="Center">
                    <TextBlock Text="◇" Foreground="#8888D6" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="还没有历史项目" Foreground="#5A5A70" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Text="新建工具或浏览已有项目后会显示在这里" Foreground="#9696A7" FontSize="9" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="#B65B66" FontSize="9.5" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="350"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RemoveButton" Content="移除记录" Style="{StaticResource AdminGlassButton}" Foreground="#B85D68" Margin="0,0,8,0" IsEnabled="False" Click="RemoveButton_Click"/>
                <Button x:Name="OpenButton" Content="打开选中项目" Style="{StaticResource AdminPrimaryButton}" MinWidth="120" IsEnabled="False" Click="OpenButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
