<Page x:Class="XFEToolBox.Client.Views.Pages.Popups.NormalDialogPopupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:viewmodel="clr-namespace:XFEToolBox.Client.ViewModel.Pages.Popups"
      xmlns:local="clr-namespace:XFEToolBox.Client.Views.Pages.Popups"
      xmlns:popups="clr-namespace:XFEToolBox.Client.ViewModel.Pages.Popups"
      xmlns:controls="clr-namespace:XFEToolBox.Client.Views.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NormalDialogPopupPage"
      d:DataContext="{d:DesignInstance Type=popups:NormalDialogPopupPageViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ConfirmGridLength}"/>
            <ColumnDefinition Width="{Binding YesGridLength}"/>
            <ColumnDefinition Width="{Binding NoGridLength}"/>
            <ColumnDefinition Width="{Binding CancelGridLength}"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Frame Grid.ColumnSpan="4" Content="{Binding Content}" NavigationUIVisibility="Hidden"/>
        <Button Grid.Row="1" Content="{Binding ConfirmText}" controls:ButtonAssist.IsPrimary="True" MinWidth="88"
                VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding ConfirmCommand}"/>
        <Button Grid.Row="1" Grid.Column="1" Content="{Binding YesText}" controls:ButtonAssist.IsPrimary="True" MinWidth="88"
                VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding YesCommand}"/>
        <Button Grid.Row="1" Grid.Column="2" Content="{Binding NoText}" MinWidth="88"
                VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding NoCommand}"/>
        <Button Grid.Row="1" Grid.Column="3" Content="{Binding CancelText}" MinWidth="88"
                VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding CancelCommand}"/>
    </Grid>
</Page>
