<Page x:Class="XFEToolBox.Client.Views.Pages.ToolBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F7F8FC" Title="在线工具" Loaded="Page_Loaded">
    <Grid Margin="25,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="在线工具库" FontSize="26" FontWeight="Bold" Foreground="#29293D"/><TextBlock Text="从服务器获取经过校验的 XAML + C# 工具源码包。" Foreground="#7C7C91" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox" Height="38" Padding="12,0" VerticalContentAlignment="Center" BorderBrush="#DEDEEA" KeyDown="SearchTextBox_KeyDown"/>
            <Button Grid.Column="1" Content="搜索" Padding="18,8" Margin="8,0" Background="#7777DB" Foreground="White" BorderThickness="0" Click="SearchButton_Click"/>
            <Button Grid.Column="2" Content="刷新" Padding="18,8" Click="RefreshButton_Click"/>
        </Grid>
        <Border Grid.Row="2" Background="White" CornerRadius="15" BorderBrush="#E9E9F3" BorderThickness="1" Padding="8">
            <DataGrid x:Name="ToolGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*"/>
                    <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2*"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="版本" Binding="{Binding LatestVersion}" Width="85"/>
                    <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#6E6E84" VerticalAlignment="Center"/>
            <Button Content="下载选中工具包" HorizontalAlignment="Right" Padding="18,8" Background="#7777DB" Foreground="White" BorderThickness="0" Click="DownloadButton_Click"/>
        </Grid>
    </Grid>
</Page>
