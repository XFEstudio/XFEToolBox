<Page x:Class="XFEToolBox.Client.Views.Pages.DownloadInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White" Title="软件下载详情">
    <Page.Resources>
        <Style x:Key="DetailButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="20,0"/><Setter Property="Foreground" Value="#66667A"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DADAEA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#AFAFE6"/><Setter Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DetailButtonStyle}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#8585DF"/><Setter Property="BorderBrush" Value="#8585DF"/>
        </Style>
        <Style x:Key="ChannelItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="#505066"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EEEEFB"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E3E3F8"/><Setter Property="Foreground" Value="#5F5FBA"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChannelComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#55556A"/><Setter Property="Background" Value="#F8F8FD"/><Setter Property="BorderBrush" Value="#DDDDEC"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,0,8,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChannelItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Surface" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="10">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <ContentPresenter Margin="12,0,4,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="#55556A"/>
                                        <Path Grid.Column="1" Width="8" Height="5" Stretch="Fill" Fill="#8585D8" Data="M 0,0 L 4,4 L 8,0 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#AAAADF"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Root}" Margin="0,5,0,0" Padding="5" Background="White" BorderBrush="#DDDDEC" BorderThickness="1" CornerRadius="11">
                                <Border.Effect><DropShadowEffect Color="#3C365D" BlurRadius="18" ShadowDepth="4" Opacity="0.20"/></Border.Effect>
                                <ScrollViewer MaxHeight="190"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ConsoleScrollBar}"/></ScrollViewer.Resources>
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="17" Background="#F7F7FD" CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="White" CornerRadius="17" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border.Effect><DropShadowEffect Color="#7777C9" BlurRadius="12" ShadowDepth="2" Opacity="0.12"/></Border.Effect>
                        <Image Source="{Binding IconSource}" Width="38" Height="38" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" Foreground="#343448" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#818195" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Padding="8,3" Background="#E9E9FA" CornerRadius="7"><TextBlock Text="{Binding Category}" Foreground="#7777C9" FontSize="9.5"/></Border>
                            <Border Padding="8,3" Margin="7,0,0,0" Background="#EFEFF5" CornerRadius="7"><TextBlock Text="{Binding DownloadModeText}" Foreground="#77778A" FontSize="9.5"/></Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,13,0,0" Padding="17" Background="White" BorderBrush="#E7E7F0" BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="软件介绍" Foreground="#444459" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" Margin="0,8,0,0" Foreground="#77778B" FontSize="10.5" LineHeight="18" TextWrapping="Wrap"/>
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="发布者" Foreground="#A0A0B1" FontSize="9"/><TextBlock Text="{Binding Publisher}" Foreground="#55556A" FontSize="10.5" Margin="0,3,8,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="版本" Foreground="#A0A0B1" FontSize="9"/><TextBlock Text="{Binding Version}" Foreground="#55556A" FontSize="10.5" Margin="0,3,8,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="获取方式" Foreground="#A0A0B1" FontSize="9"/><TextBlock Text="{Binding DownloadModeText}" Foreground="#55556A" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="下载渠道" Foreground="#77778B" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock Text="可选择不同来源" Foreground="#A0A0B1" FontSize="8.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Height="38" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                                  DisplayMemberPath="Name" Style="{StaticResource ChannelComboBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Visibility="{Binding NoticeVisibility}" Margin="0,11,0,0" Padding="13,10" Background="#FFF8E8" CornerRadius="11">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="!" Foreground="#D99A28" FontSize="15" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Notice}" Foreground="#87692E" FontSize="9.8" LineHeight="16" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding ProgressVisibility}" Foreground="#8585DF" Background="#EDEDF7" BorderThickness="0"/>
                <TextBlock Text="{Binding StatusText}" Margin="2,8,2,0" Foreground="#77778B" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,17,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="打开官网" Visibility="{Binding WebsiteVisibility}" Command="{Binding OpenWebsiteCommand}" Style="{StaticResource DetailButtonStyle}"/>
                <Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding DownloadButtonName}" IsEnabled="{Binding CanDownload}"
                        Command="{Binding DownloadClickCommand}" Style="{StaticResource DetailPrimaryButtonStyle}"/>
            </Grid>

            <TextBlock Grid.Row="5" Margin="2,12,2,0" Text="下载地址来自当前工具服务器；执行安装程序前请再次核对发布者与数字签名。"
                       Foreground="#A4A4B3" FontSize="9" TextWrapping="Wrap"/>
        </Grid>
    </ScrollViewer>
</Page>
