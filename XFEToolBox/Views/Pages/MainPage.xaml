<Page x:Class="XFEToolBox.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ctr="clr-namespace:XFEToolBox.Views.Controls"
      xmlns:local="clr-namespace:XFEToolBox.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Loaded="Page_Loaded">
    <Grid>
        <ctr:SmoothScrollViewer>
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ConsoleScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel Orientation="Vertical">
                <ctr:Carousel x:Name="mainCarousel" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="220"/>
                <TextBlock Margin="10,0" Text="最近使用" Foreground="{DynamicResource BackgroundColor}" FontSize="15" FontWeight="Bold"/>
                <Border CornerRadius="15" Background="White" Margin="10" Padding="10">
                    <WrapPanel MinHeight="500">
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ctr:SmoothScrollViewer>
    </Grid>
</Page>
