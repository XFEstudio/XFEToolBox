<Page x:Class="XFEToolBox.Client.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:XFEToolBox.Client.Views.Pages"
      xmlns:controls="clr-namespace:XFEToolBox.Client.Views.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">
    <Grid>
        <controls:SmoothScrollViewer Padding="10,0,0,0">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ConsoleScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel Orientation="Vertical">
                <controls:Carousel x:Name="mainCarousel" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="350"/>
                <TextBlock Text="最近使用" Foreground="{DynamicResource BackgroundColor}" FontSize="15" FontWeight="Bold"/>
                <Border CornerRadius="15" Background="White" Margin="0,10" Padding="10">
                    <WrapPanel MinHeight="300">
                    </WrapPanel>
                </Border>
            </StackPanel>
        </controls:SmoothScrollViewer>
    </Grid>
</Page>
