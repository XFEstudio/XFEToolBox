<UserControl x:Class="XFEToolBox.Client.Views.Controls.WindowCaptionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Height="25">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="0,0,20,20" Style="{StaticResource TabBorderStyle}"
                Visibility="{Binding DragHandleVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
                MouseMove="DragSurface_MouseMove">
            <Image Source="/XFEToolBox.Client;component/Resources/Image/tabline.png" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Margin="4" IsHitTestVisible="False"/>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Image Width="37" Style="{StaticResource RotorImage}" Source="/XFEToolBox.Client;component/Resources/Image/min.png"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"
                   Cursor="Hand" Visibility="{Binding MinimizeButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   MouseLeftButtonUp="MinimizeImage_MouseLeftButtonUp"/>
            <Image Width="37" Style="{StaticResource HalfRotorImage}" Source="/XFEToolBox.Client;component/Resources/Image/close.png"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"
                   Cursor="Hand" Visibility="{Binding CloseButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   MouseLeftButtonUp="CloseImage_MouseLeftButtonUp"/>
        </StackPanel>
    </Grid>
</UserControl>
