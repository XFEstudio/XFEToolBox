<Window x:Class="XFEToolBox.Client.Views.Windows.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="246" Height="258" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="TrayActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#45455A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EEEEFB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#DFDFF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="9" Background="#FAFAFF" BorderBrush="#9797E2" BorderThickness="1"
            CornerRadius="18" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.32" Color="#29294D"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Margin="-10,-10,-10,7" CornerRadius="17,17,8,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8787DE" Offset="0"/>
                        <GradientStop Color="#A1A1EA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/XFEToolBox;component/Resources/Icon/XFEToolBoxLogo.png" Width="27" Height="27"/>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="XFE·工具箱" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="效率工作台" Foreground="#EDEDFD" FontSize="9" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1">
                <Button Style="{StaticResource TrayActionButtonStyle}" Click="OpenHomeButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="▦" Foreground="#8585D8" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="打开主页" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource TrayActionButtonStyle}" Click="OpenPaletteButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" Foreground="#8585D8" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="打开命令面板" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="快捷键" Foreground="#9292A6" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Border Height="1" Margin="10,4" Background="#E5E5F1"/>
                <Button Style="{StaticResource TrayActionButtonStyle}" Margin="0,2,0,8" Click="ExitButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="×" Foreground="#D26F82" FontSize="19" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="退出 XFEToolBox" Foreground="#A54E60" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
