<Window x:Class="XFEToolBox.Client.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:XFEToolBox.Client.ViewModel.Windows"
        xmlns:controls="clr-namespace:XFEToolBox.Client.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=windows:MainWindowViewModel}"
        Title="XFE工具箱" Height="460" Width="730" MinHeight="450" MinWidth="720" Background="Transparent" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" Icon="/Resources/Icon/XFEToolBoxIcon.ico" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="AccountEntryStyle" TargetType="Border">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="9"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="#FFFFFF"/></Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value><SolidColorBrush Color="#4D9898E7"/></Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#7777C9" BlurRadius="14" ShadowDepth="3" Opacity="0"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#F7F7FF" Duration="0:0:0.16"/>
                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#9898E7" Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.22" Duration="0:0:0.16"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.18"/>
                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#4D9898E7" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.08"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountMenuButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F6F6FC"/>
            <Setter Property="Foreground" Value="#45455B"/>
            <Setter Property="BorderBrush" Value="#E5E5F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <controls:RoundedClipBorder x:Name="MainSurface" CornerRadius="19" Background="{DynamicResource MainColor}" Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="20,0,0,20" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource BackgroundColor}"/>
            <Border Grid.Column="1" Grid.Row="0" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="backTabBorder" CornerRadius="10" Style="{StaticResource TabBorderStyle}" Visibility="Collapsed" MouseLeftButtonUp="BackTabBorder_MouseLeftButtonUp">
                        <Image HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" Source="/Resources/Image/back.png"/>
                    </Border>
                    <Border Grid.Column="1" x:Name="dragTabBorder" CornerRadius="0,0,20,20" Style="{StaticResource TabBorderStyle}" MouseMove="DragTabBorder_MouseMove" MouseDown="DragTabBorder_MouseDown">
                        <Image x:Name="dragTabImage" Source="/Resources/Image/tabline.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                    </Border>
                    <Image x:Name="minimizeImage" Style="{StaticResource RotorImage}" Grid.Column="2" Source="/Resources/Image/min.png" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4" MouseLeftButtonUp="MinimizeImage_MouseLeftButtonUp"/>
                    <Image x:Name="closeWindowImage" Style="{StaticResource HalfRotorImage}" Grid.Column="3" Source="/Resources/Image/close.png" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4" MouseLeftButtonUp="CloseWindowImage_MouseLeftButtonUp"/>
                </Grid>
            </Border>
            <Border Grid.Column="0" Grid.Row="0" Background="Transparent">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Span Foreground="#9898e7" FontSize="18" FontWeight="Bold">XFE·工具箱</Span>
                </TextBlock>
            </Border>
            <StackPanel Grid.Column="0" Grid.Row="1">
                <controls:NavigationButton x:Name="mainButton" Command="{Binding NavigateToPageCommand}" CommandParameter="home">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Resources/Image/grid.png" Margin="5"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="首页"/>
                    </Grid>
                </controls:NavigationButton>
                <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="tool">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Resources/Image/toolbox.png" Margin="7"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="工具箱"/>
                    </Grid>
                </controls:NavigationButton>
                <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="console">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Resources/Image/console.png" Margin="7"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="C#控制台"/>
                    </Grid>
                </controls:NavigationButton>
                <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="download">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Resources/Image/download.png" Margin="7"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="下载专区"/>
                    </Grid>
                </controls:NavigationButton>
                <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="setting">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="/Resources/Image/setting.png" Margin="7"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="选项设置"/>
                    </Grid>
                </controls:NavigationButton>
            </StackPanel>

            <!-- 登录与账户入口只占用原侧栏左下角，不影响原有导航。 -->
            <Border x:Name="AccountEntry" Grid.Column="0" Grid.Row="1" Style="{StaticResource AccountEntryStyle}"
                    MouseLeftButtonUp="AccountEntry_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="29" Height="29" CornerRadius="10" Background="#9898E7">
                        <TextBlock Text="X" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserName}" Foreground="#4B4B5E" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentUserRole}" Foreground="#8A8A9D" FontSize="9.5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountEntry}" Placement="Right" VerticalOffset="-165"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border Width="285" Padding="18" Background="White" BorderBrush="#E4E4EF" BorderThickness="1" CornerRadius="16">
                    <Border.Effect><DropShadowEffect Color="#3C365D" BlurRadius="22" ShadowDepth="5" Opacity="0.22"/></Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="17" FontWeight="Bold" Foreground="#313145"/>
                            <TextBlock Text="{Binding CurrentUserRole}" Foreground="#858598" FontSize="11" Margin="0,3,0,10"/>
                            <StackPanel Visibility="{Binding AdministratorVisibility}">
                                <TextBlock Text="服务器管理" Foreground="#77778F" FontSize="11" Margin="0,0,0,3"/>
                                <Button Content="服务器概览" Tag="serverOverview" Style="{StaticResource AccountMenuButton}" Click="AdminMenuButton_Click"/>
                                <Button Content="用户与权限" Tag="userManagement" Style="{StaticResource AccountMenuButton}" Click="AdminMenuButton_Click"/>
                                <Button Content="工具发布" Tag="toolManagement" Style="{StaticResource AccountMenuButton}" Click="AdminMenuButton_Click"/>
                                <Button Content="工具代码编辑器" Tag="editor" Style="{StaticResource AccountMenuButton}" Click="AdminMenuButton_Click"/>
                            </StackPanel>
                            <Button Content="退出登录" Height="32" Margin="0,9,0,0" Foreground="#B25555" Background="Transparent" BorderBrush="#E6CACA" Click="PopupLogoutButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Popup>

            <Frame x:Name="contentFrame" Style="{StaticResource NavigationFrame}" Content="{Binding CurrentPage}" Navigated="ContentFrame_Navigated"/>
            <Image Grid.Column="1" Grid.Row="1" Source="/Resources/Image/corner.png" Width="25" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" FocusVisualStyle="{x:Null}"/>
            <Border x:Name="cornerBorder" Grid.Column="1" Grid.Row="1" Style="{StaticResource CornerBorderStyle}" MouseDown="CornerBorder_MouseDown"/>
        </Grid>
    </controls:RoundedClipBorder>
</Window>
