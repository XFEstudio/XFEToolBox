<Window x:Class="XFEToolBox.Client.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:XFEToolBox.Client.ViewModel.Windows"
        xmlns:windows="clr-namespace:XFEToolBox.Client.ViewModel.Windows"
        xmlns:controls="clr-namespace:XFEToolBox.Client.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=windows:MainWindowViewModel}"
        Title="XFE工具箱" Height="680" Width="1024" MinHeight="600" MinWidth="900" Background="Transparent" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" Icon="/Resources/Icon/XFEToolBoxIcon.ico" Loaded="Window_Loaded">

    <Border CornerRadius="19" Background="{DynamicResource MainColor}" Margin="5" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="20,0,0,20" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource BackgroundColor}"/>
            <Border Grid.Column="1" Grid.Row="0" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="backTabBorder" CornerRadius="10" Style="{StaticResource TabBorderStyle}" Visibility="Collapsed" MouseLeftButtonUp="BackTabBorder_MouseLeftButtonUp">
                        <Image HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" Source="/Resources/Image/back.png"/>
                    </Border>
                    <Border Grid.Column="1" x:Name="dragTabBorder" CornerRadius="0,0,20,20" Style="{StaticResource TabBorderStyle}" MouseMove="DragTabBorder_MouseMove" MouseDown="DragTabBorder_MouseDown">
                        <Image x:Name="dragTabImage" Source="/Resources/Image/tabline.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                    </Border>
                    <Image x:Name="minimizeImage" Style="{StaticResource RotorImage}" Grid.Column="2" Source="/Resources/Image/min.png" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4" MouseLeftButtonUp="MinimizeImage_MouseLeftButtonUp"/>
                    <Image x:Name="closeWindowImage" Style="{StaticResource HalfRotorImage}" Grid.Column="3" Source="/Resources/Image/close.png" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4" MouseLeftButtonUp="CloseWindowImage_MouseLeftButtonUp"/>
                </Grid>
            </Border>
            <Border Grid.Column="0" Grid.Row="0" Background="Transparent">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Span Foreground="#9898e7" FontSize="18" FontWeight="Bold">XFE·工具箱</Span>
                </TextBlock>
            </Border>
            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding AuthenticatedVisibility}">
                    <StackPanel>
                        <controls:NavigationButton x:Name="mainButton" Command="{Binding NavigateToPageCommand}" CommandParameter="home">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/Resources/Image/grid.png" Margin="5"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="首页"/></Grid>
                        </controls:NavigationButton>
                        <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="tool">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/Resources/Image/toolbox.png" Margin="7"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="在线工具"/></Grid>
                        </controls:NavigationButton>
                        <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="console">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/Resources/Image/console.png" Margin="7"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="C#控制台"/></Grid>
                        </controls:NavigationButton>
                        <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="download">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/Resources/Image/download.png" Margin="7"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="下载专区"/></Grid>
                        </controls:NavigationButton>
                        <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="setting">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/Resources/Image/setting.png" Margin="7"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="选项设置"/></Grid>
                        </controls:NavigationButton>
                        <StackPanel Visibility="{Binding AdministratorVisibility}">
                            <TextBlock Text="服务器管理" Foreground="#8A8AA6" FontSize="11" FontWeight="SemiBold" Margin="17,17,0,6"/>
                            <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="serverOverview">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="☁" FontSize="19" Margin="10,0" VerticalAlignment="Center" Foreground="#7777CF"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="服务器概览"/></Grid>
                            </controls:NavigationButton>
                            <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="userManagement">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="♟" FontSize="19" Margin="10,0" VerticalAlignment="Center" Foreground="#7777CF"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="用户与权限"/></Grid>
                            </controls:NavigationButton>
                            <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="toolManagement">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/Resources/Image/wrench.png" Margin="8"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="工具发布"/></Grid>
                            </controls:NavigationButton>
                            <controls:NavigationButton Command="{Binding NavigateToPageCommand}" CommandParameter="editor">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/Resources/Image/console.png" Margin="8"/><TextBlock Grid.Column="1" Style="{StaticResource NavigationButtonText}" Text="代码编辑器"/></Grid>
                            </controls:NavigationButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Margin="10" Padding="11" CornerRadius="13" Background="#0B9898E7" BorderBrush="#259898E7" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="11" Background="#9898E7"><TextBlock Text="X" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="12" FontWeight="SemiBold" Foreground="#44445A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontSize="10" Foreground="#8B8B9F"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="登录" Visibility="{Binding LoginVisibility}" Command="{Binding NavigateToPageCommand}" CommandParameter="login" Padding="6,3" Foreground="#6666C5" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="退出" Visibility="{Binding LogoutVisibility}" Command="{Binding LogoutCommand}" Padding="6,3" Foreground="#B06767" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>
            <Frame x:Name="contentFrame" Style="{StaticResource NavigationFrame}" Content="{Binding CurrentPage}" Navigated="ContentFrame_Navigated"/>
            <Image Grid.Column="1" Grid.Row="1" Source="/Resources/Image/corner.png" Width="25" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" FocusVisualStyle="{x:Null}"/>
            <Border x:Name="cornerBorder" Grid.Column="1" Grid.Row="1" Style="{StaticResource CornerBorderStyle}" MouseDown="CornerBorder_MouseDown">
            </Border>
        </Grid>
    </Border>
</Window>
