<Window x:Class="XFEToolBox.Client.Views.Windows.ToolCodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="XFEToolBox Code Studio" Width="1280" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#181825" Foreground="#E8E8F2" Icon="/Resources/Icon/XFEToolBoxIcon.ico">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E3E3EF"/><Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="BorderBrush" Value="#3B3B53"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#3A3A54"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
        <Border Background="#181825" BorderBrush="#303044" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="新建工具" Style="{StaticResource ToolButton}" Click="NewProjectButton_Click"/>
                    <Button Content="打开文件夹" Style="{StaticResource ToolButton}" Click="OpenFolderButton_Click"/>
                    <Button Content="新建文件" Style="{StaticResource ToolButton}" Click="NewFileButton_Click"/>
                    <Button Content="保存全部  Ctrl+S" Style="{StaticResource ToolButton}" Background="#6262B8" Click="SaveButton_Click"/>
                    <Button Content="格式化  Shift+Alt+F" Style="{StaticResource ToolButton}" Click="FormatButton_Click"/>
                    <Button Content="导出 .xfetool" Style="{StaticResource ToolButton}" Click="PackageButton_Click"/>
                </StackPanel>
                <TextBlock Text="XFEToolBox Code Studio" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#AFAFD2" Margin="0,0,6,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#1B1B29" BorderBrush="#303044" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Text="工程资源管理器" FontSize="12" FontWeight="SemiBold" Foreground="#C7C7D8" VerticalAlignment="Center" Margin="13,0"/>
                    <ListBox x:Name="FileList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#D3D3E1" SelectionChanged="FileList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><Grid Height="31"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" VerticalAlignment="Center" Foreground="#B5B5D6"/><TextBlock Grid.Column="1" Text="{Binding RelativePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="8,5"><Button Content="删除选中文件" Style="{StaticResource ToolButton}" Margin="0" Foreground="#E8A1A1" Click="DeleteFileButton_Click"/></Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#2A2A3B"/>
            <Grid Grid.Column="2">
                <wv2:WebView2 x:Name="EditorWebView" DefaultBackgroundColor="#1E1E2E"/>
                <Border x:Name="EditorLoading" Background="#1E1E2E">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在启动 Monaco Editor…" FontSize="16" Foreground="#BDBDD2" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EditorLoadingDetail" Text="加载本地编辑器资源" Foreground="#73738B" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#7777C9" Padding="8,0">
            <Grid><TextBlock x:Name="WorkspacePathText" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="HostStatusText" Text="就绪" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid>
        </Border>
    </Grid>
</Window>
